APP_NAME="Breeze AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not SQLite. A takeoff writes its whole response in one transaction while
# the processing screen polls; on a single SQLite file that writer locked out every
# reader, and a blocked poll took the PHP process down with it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_takeoff
DB_USERNAME=ai_takeoff
DB_PASSWORD=

# Only needed once, to carry a pre-MySQL database forward:
#   php artisan takeoff:import-sqlite
# DB_LEGACY_DATABASE=/absolute/path/to/database/database.sqlite

# `DatabaseSeeder` refuses to run in production (it creates real accounts
# with a publicly-known password) unless this is explicitly true — only set
# it on a deliberate demo/staging instance, never on production.
ALLOW_DEMO_SEEDING=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Laravel does not force this on its own — set to true in production (HTTPS)
# so the session cookie is never sent over plain HTTP. Leave unset/false for
# local HTTP development.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Realtime (Laravel Reverb). REVERB_SERVER_HOST/PORT is what `reverb:start`
# actually binds to on this machine; REVERB_HOST/PORT/SCHEME is the public
# address a browser connects to — behind a reverse proxy in production these
# are deliberately different (see docs/realtime.md). Never commit a real
# REVERB_APP_SECRET — it signs private-channel auth and must stay server-side.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated production HOSTNAMES (no scheme/port) allowed to open a
# WebSocket connection. Never "*" in production — see docs/realtime.md.
REVERB_APP_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Largest PDF/CAD file the product will accept per upload. Also raise PHP's own
# upload_max_filesize/post_max_size to match (see public/.user.ini, .htaccess,
# and the composer "dev" scripts) — this setting alone cannot lift PHP's ceiling.
TAKEOFF_MAX_FILE_SIZE_MB=500

# AI takeoff engine — the FastAPI "Electrical Drawing AI Takeoff Engine".
# POST /api/upload is synchronous, so no polling settings are needed.
AI_API_BASE_URL=http://127.0.0.1:8000
AI_API_KEY=
# How AI_API_KEY is sent — "bearer" (Authorization: Bearer <key>) or
# "header" (a raw header named by AI_API_KEY_HEADER). Only matters once
# AI_API_KEY is actually set.
AI_API_AUTH_MODE=bearer
AI_API_KEY_HEADER=X-API-Key
AI_API_ANALYSE_TIMEOUT=900
# Reviewer decisions are pushed to /api/review/* so the engine's library learns.
AI_LEARNING_ENABLED=true
# The engine's debug directory, used only to resolve which run produced an
# analysis (its upload response carries no run_id). Crop data itself is read over
# HTTP. Leave blank when the engine runs on another host.
AI_LIFECYCLE_ENABLED=true
AI_LIFECYCLE_DIR=
# Where takeoff artefacts (previews, thumbnails, annotated PDFs, response
# JSON) are written — private storage, never `public`.
AI_STORAGE_DISK=local
# Only needed if pdftoppm (poppler-utils) isn't on PATH under this name —
# e.g. a full absolute path on a host that installs it elsewhere.
PDFTOPPM_BINARY=pdftoppm

# Estimating: the engine prices its own bill of quantities, so these only fill
# gaps (markup is not part of the engine's model).
ESTIMATE_MARKUP_PCT=0
ESTIMATE_TAX_PCT=8.25
ESTIMATE_LABOR_RATE=50

# Time Tracking business rules — only used to seed the one
# `time_tracking_settings` row the first time it's read; an admin edits the
# row itself afterward, not these values.
TIME_TRACKING_REGULAR_DAILY_HOURS=8
TIME_TRACKING_REGULAR_WEEKLY_HOURS=40
TIME_TRACKING_OVERTIME_MULTIPLIER=1.5
TIME_TRACKING_WEEKEND_OVERTIME=true
TIME_TRACKING_HOLIDAY_OVERTIME=true
TIME_TRACKING_DEFAULT_BILLABLE_RATE=
TIME_TRACKING_DEFAULT_COST_RATE=
TIME_TRACKING_TIMEZONE=UTC

# Mobile API (Sanctum) — see docs/mobile-api.md. Minutes until a mobile
# token expires; never leave tokens non-expiring in production.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Address lookup on the Site / Location field — Google Places API (New).
# The call is made server-side, so this key never reaches the browser: restrict
# it by API to "Places API (New)", not by referrer. Unset, the field stays a
# plain text box and an address is saved without coordinates.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REGIONS=us,ca
