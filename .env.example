APP_NAME=Breeze
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not SQLite. A takeoff writes its whole response in one transaction while
# the processing screen polls; on a single SQLite file that writer locked out every
# reader, and a blocked poll took the PHP process down with it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_takeoff
DB_USERNAME=ai_takeoff
DB_PASSWORD=

# Only needed once, to carry a pre-MySQL database forward:
#   php artisan takeoff:import-sqlite
# DB_LEGACY_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Largest PDF/CAD file the product will accept per upload. Also raise PHP's own
# upload_max_filesize/post_max_size to match (see public/.user.ini, .htaccess,
# and the composer "dev" scripts) — this setting alone cannot lift PHP's ceiling.
TAKEOFF_MAX_FILE_SIZE_MB=500

# AI takeoff engine — the FastAPI "Electrical Drawing AI Takeoff Engine".
# POST /api/upload is synchronous, so no polling settings are needed.
AI_API_BASE_URL=http://127.0.0.1:8000
AI_API_KEY=
AI_API_ANALYSE_TIMEOUT=900
# Reviewer decisions are pushed to /api/review/* so the engine's library learns.
AI_LEARNING_ENABLED=true
# The engine's debug directory, used only to resolve which run produced an
# analysis (its upload response carries no run_id). Crop data itself is read over
# HTTP. Leave blank when the engine runs on another host.
AI_LIFECYCLE_ENABLED=true
AI_LIFECYCLE_DIR=

# Estimating: the engine prices its own bill of quantities, so these only fill
# gaps (markup is not part of the engine's model).
ESTIMATE_MARKUP_PCT=0
ESTIMATE_TAX_PCT=8.25
ESTIMATE_LABOR_RATE=78
