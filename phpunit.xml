<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The same engine the application runs on. An in-memory SQLite would be
             quicker, but it accepts things MySQL rejects — strict-mode truncation,
             JSON column semantics, invalid dates — so it hides exactly the failures
             a test run exists to catch. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="ai_takeoff_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="ai_takeoff"/>
        <env name="DB_PASSWORD" value="ai_takeoff_local"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Tests run against the real engine. Nothing is faked; engine-dependent
             tests skip when it is not reachable. -->
        <env name="AI_API_BASE_URL" value="http://127.0.0.1:8000"/>
        <env name="AI_API_ANALYSE_TIMEOUT" value="900"/>
        <!-- Off deliberately: a test run must not teach (or pollute) the engine's
             shared symbol library. -->
        <env name="AI_LEARNING_ENABLED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
